#!/usr/bin/env bash
#
# apply-config — copy one repo's workflow config across a directory of repos.
#
#   apply-config --from <configured-repo> --to <dir> [--dry-run]
#   apply-config --from ~/dev/acme/api --to ~/dev/acme
#
# Config is per repo by design: the board, branches and conventions belong to
# the repository, not to a folder. But when a team shares one board across
# thirty repos, ninety per cent of every config is identical and only the
# service name differs. This copies the shared part and leaves the rest to you.
#
# It does NOT invent anything. Run /board-setup once on a repo you care about,
# check the config is right, then fan it out with this.
#
# What is copied:   project, branches, capabilities, priority, size, complexity,
#                   models, epics, style, labels, diagrams
# What is NOT:      tests, logging, apiConventions, environments
#
# The four it skips are genuinely per repo. A Go service and a React app do not
# share a test command, and pretending otherwise writes a config that fails on
# first use. taxonomy.serviceLabels is rewritten per repo from the git remote.
#
set -euo pipefail

die()  { printf '\033[31merror\033[0m %s\n' "$1" >&2; exit 1; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$1"; }
skip() { printf '  \033[2m-\033[0m %s\n' "$1"; }

FROM=""; TO=""; DRY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --from)    FROM="${2:-}"; shift 2 ;;
    --to)      TO="${2:-}";   shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -n "$FROM" && -n "$TO" ]] || die "usage: apply-config --from <repo> --to <dir> [--dry-run]"
command -v jq >/dev/null || die "jq is not installed"

SRC="$FROM/.claude/workflow.config.json"
[[ -f "$SRC" ]] || die "no config at $SRC
    Run /board-setup in that repo first, and check the result before fanning it out."
jq -e . "$SRC" >/dev/null || die "$SRC is not valid JSON"

# The shared half. Everything else is per repo and is deliberately left alone.
SHARED='{project,branches,capabilities,priority,size,complexity,models,epics,style,labels,diagrams}'

(( DRY == 1 )) && printf '\033[2mdry run — nothing will be written\033[0m\n'
printf '\nsource: %s\n' "$SRC"
printf 'board:  %s/%s\n\n' "$(jq -r '.project.owner' "$SRC")" "$(jq -r '.project.number' "$SRC")"

applied=0; skipped=0

for repo in "$TO"/*/; do
  [[ -d "$repo/.git" ]] || continue
  name="$(basename "$repo")"

  if [[ "$(cd "$repo" && pwd)" == "$(cd "$FROM" && pwd)" ]]; then
    skip "$name (the source)"
    continue
  fi

  dest="$repo/.claude/workflow.config.json"
  if [[ -f "$dest" ]]; then
    warn "$name already configured — left alone"
    skipped=$((skipped + 1))
    continue
  fi

  # The service name comes from the remote, not the directory name: a folder
  # can be renamed and often has been.
  remote="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
  if [[ -z "$remote" ]]; then
    warn "$name has no origin remote — skipped, set it up by hand"
    skipped=$((skipped + 1))
    continue
  fi
  # BSD sed has no non-greedy quantifier, so strip the suffix first rather
  # than trying to match around it.
  reponame="${remote%.git}"; reponame="${reponame##*/}"

  if (( DRY == 1 )); then
    ok "$name -> would write, service key '$reponame'"
    applied=$((applied + 1))
    continue
  fi

  mkdir -p "$repo/.claude"
  jq --arg r "$reponame" \
     "$SHARED
      | .[\"\$schema\"] = \"https://raw.githubusercontent.com/amlwwalker/kanban-tdd/main/skills/board-setup/references/workflow.config.schema.json\"
      | with_entries(select(.value != null))" "$SRC" > "$dest.tmp"

  # Carry the taxonomy across, but point serviceLabels at THIS repo only.
  if jq -e '.taxonomy' "$SRC" >/dev/null 2>&1; then
    jq --slurpfile src "$SRC" --arg r "$reponame" \
      '. + {taxonomy: ($src[0].taxonomy
        | .serviceLabels.map = ({} | .[$r] = ($src[0].taxonomy.serviceLabels.map[$r] // $r)))}' \
      "$dest.tmp" > "$dest.tmp2" && mv "$dest.tmp2" "$dest.tmp"
  fi

  mv "$dest.tmp" "$dest"
  ok "$name -> $dest"
  applied=$((applied + 1))
done

printf '\n%d written, %d skipped\n' "$applied" "$skipped"

cat <<'NEXT'

Still to do in each repo, because these cannot be shared:

  tests            the command and glob differ per stack
  logging          the call pattern differs per language
  apiConventions   only where the repo serves an API
  environments     where a human can try that service

Add them with /board-setup in the repo — it reads the existing file and
extends it rather than starting over. Then:

  ghboard validate     confirms the config matches the live board
  ghboard list         this repo's cards on the shared board

Commit .claude/workflow.config.json in each repo so colleagues inherit it.
NEXT
